# style=direct     — the prompt paraphrases the tool's own description.
#                    A WEAK test: it measures keyword matching, not routing
#                    judgement. Treat these as a floor, never as evidence
#                    that a tool is reachable in real use.
# style=indirect    — the user describes a SITUATION and never names the
#                    concept. Reaching the right tool requires inference.
# style=proactive   — the tool use is not requested at all; it is part of
#                    doing the stated job well. This is the bar for an agent
#                    that should hunt problems rather than wait to be asked.
{"id": "arch-map", "style": "direct", "family": "architecture-overview", "intended": ["communities", "god_nodes", "stats"], "prompt": "Give me a high-level map of this codebase's functional areas and the most load-bearing modules or classes. Where would a new contributor start reading? Do not modify any files."}
{"id": "bridges", "style": "direct", "family": "architecture-overview", "intended": ["bridges"], "prompt": "Which few nodes hold otherwise-separate parts of this codebase together — the articulation points whose removal would disconnect functional areas? Do not modify any files."}
{"id": "twins", "style": "direct", "family": "architecture-smell", "intended": ["twin_paths"], "prompt": "I suspect there are parallel implementations of the same logic somewhere in this codebase — copy-paste twins that have drifted apart. Find the strongest candidates worth unifying. Do not modify any files."}
{"id": "discrim", "style": "direct", "family": "architecture-smell", "intended": ["discriminations"], "prompt": "Which string or enum tags does the code repeatedly branch on across many functions? I am hunting for missing-abstraction smells where a type should replace scattered if/match on the same tag. Do not modify any files."}
{"id": "conformers", "style": "direct", "family": "architecture-smell", "intended": ["protocol_conformers"], "prompt": "Which classes in this codebase implement the same implicit interface — the same set of method names — without sharing a base class? Do not modify any files."}
{"id": "dead-code", "style": "direct", "family": "architecture-smell", "intended": ["dead_functions"], "prompt": "Which functions or methods in this codebase have no callers at all — dead-code candidates? Give me the strongest candidates. Do not modify any files."}
{"id": "belongs", "style": "direct", "family": "architecture-smell", "intended": ["native_place"], "prompt": "Look at the private helper functions in {smell_module} — do any of them structurally belong in a different module, judging by who actually uses them? Do not modify any files."}
{"id": "dead-docs", "style": "direct", "family": "doc-drift", "intended": ["dead_references", "staleness"], "prompt": "Do any docstrings or theory pages in this project reference classes, functions, or equations that no longer exist in the code? Do not modify any files."}
{"id": "stale", "style": "direct", "family": "doc-drift", "intended": ["staleness"], "prompt": "Which documentation pages have drifted from the code they document — where was code changed after its docs? Do not modify any files."}
{"id": "impact", "style": "direct", "family": "safety", "intended": ["impact", "callers", "retest"], "prompt": "Is it safe to change the signature of {impact_symbol}? What would break, and which tests should I re-run afterwards? Do not modify any files."}
{"id": "provenance", "style": "direct", "family": "code-doc-fusion", "intended": ["provenance_chain", "verification_coverage"], "prompt": "For the equation labeled '{equation_label}' in the docs: where does it come from, what code implements it, and what verifies it? Do not modify any files."}
{"id": "gaps", "style": "direct", "family": "verification", "intended": ["verification_gaps", "verification_coverage", "verification_audit"], "prompt": "Which equations in the docs have no verifying tests? And are there tests that are not tagged to any equation? Do not modify any files."}
{"id": "connect", "style": "direct", "family": "exploration", "intended": ["shortest_path", "neighbors", "graph_query"], "prompt": "How is {module_a} connected to {module_b}? I want the shortest dependency path between them. Do not modify any files."}
{"id": "runtime", "style": "direct", "family": "runtime", "intended": ["runtime_runs", "runtime_hotspots", "runtime_ingest"], "prompt": "What actually executed during our last traced run, and where were the hotspots? Do not modify any files."}
{"id": "cleanup-after-delete", "style": "indirect", "family": "doc-drift", "intended": ["dead_references"], "prompt": "I just deleted {deleted_symbol} and moved a couple of its helpers elsewhere. The test suite is green. What cleanup do I still owe before this is really done? Do not modify any files."}
{"id": "release-doc-health", "style": "proactive", "family": "doc-drift", "intended": ["dead_references", "staleness", "verification_audit"], "prompt": "We're cutting a release next week. Is the documentation in a state we would be happy to publish? Do not modify any files."}
{"id": "lockstep-edits", "style": "indirect", "family": "architecture-smell", "intended": ["protocol_conformers", "twin_paths", "discriminations"], "prompt": "Every time we change one of a few classes, we find ourselves having to update several others in lockstep, and we sometimes forget one. Why might that be happening, and what would you look at? Do not modify any files."}
{"id": "parallel-work", "style": "indirect", "family": "architecture-smell", "intended": ["twin_paths"], "prompt": "Two people on the team built the cylinder and the annulus solvers independently last quarter, without talking much. Should I be worried about the state of that code? Do not modify any files."}
{"id": "onboarding-health", "style": "proactive", "family": "architecture-smell", "intended": ["twin_paths", "discriminations", "native_place", "protocol_conformers", "dead_functions", "dead_references"], "prompt": "We're onboarding three new contributors next month. Give me an honest health check on this codebase so I know what will confuse them and what we should clean up first. Do not modify any files."}
{"id": "fuzzy-boundaries", "style": "indirect", "family": "architecture-smell", "intended": ["native_place", "bridges"], "prompt": "A reviewer commented that our module boundaries have gotten fuzzy — that things live in surprising places. Is that a fair criticism here? Do not modify any files."}
{"id": "risky-change", "style": "indirect", "family": "safety", "intended": ["impact", "callers", "retest"], "prompt": "I want to add a keyword argument to {impact_symbol}. Talk me through the risk before I start. Do not modify any files."}
{"id": "todo-control", "style": "control", "family": "control-grep", "intended": [], "forbidden": ["query", "context", "graph_query", "neighbors", "callers", "impact"], "prompt": "List the TODO and FIXME comments in the {source_dir} directory. Do not modify any files."}
{"id": "readfile-control", "style": "control", "family": "control-read", "intended": [], "forbidden": ["query", "context", "graph_query", "neighbors"], "prompt": "Show me the first 20 lines of {known_file} and summarize what that module is for. Do not modify any files."}
